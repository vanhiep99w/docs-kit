{
  "name": "@vanhiep99w/docs-kit",
  "version": "0.9.0",
  "description": "Reusable documentation components and build-time integrations for MDX and Fumadocs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanhiep99w/docs-kit.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples/d2",
    "examples/terminal-session",
    "examples/code-diff",
    "examples/protocol-exchange",
    "examples/span-waterfall",
    "examples/code-walkthrough"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./d2": {
      "types": "./dist/d2/index.d.ts",
      "default": "./dist/d2/index.js"
    },
    "./components/d2": {
      "types": "./dist/components/d2.d.ts",
      "default": "./dist/components/d2.js"
    },
    "./styles/d2.css": "./dist/styles/d2.css",
    "./package.json": "./package.json",
    "./source-explorer": {
      "types": "./dist/source-explorer/index.d.ts",
      "default": "./dist/source-explorer/index.js"
    },
    "./components/source-explorer": {
      "types": "./dist/components/source-explorer/index.d.ts",
      "default": "./dist/components/source-explorer/index.js"
    },
    "./styles/source-explorer.css": "./dist/styles/source-explorer.css",
    "./styles/source-explorer-fumadocs.css": "./dist/styles/source-explorer-fumadocs.css",
    "./components/d2-interactive": {
      "types": "./dist/components/d2-interactive.d.ts",
      "default": "./dist/components/d2-interactive.js"
    },
    "./terminal-session": {
      "types": "./dist/terminal-session/index.d.ts",
      "default": "./dist/terminal-session/index.js"
    },
    "./terminal-session/data": {
      "types": "./dist/terminal-session/data.d.ts",
      "default": "./dist/terminal-session/data.js"
    },
    "./components/terminal-session": {
      "types": "./dist/components/terminal-session.d.ts",
      "default": "./dist/components/terminal-session.js"
    },
    "./styles/terminal-session.css": "./dist/styles/terminal-session.css",
    "./code-diff": {
      "types": "./dist/code-diff/index.d.ts",
      "default": "./dist/code-diff/index.js"
    },
    "./code-diff/data": {
      "types": "./dist/code-diff/data.d.ts",
      "default": "./dist/code-diff/data.js"
    },
    "./components/code-diff": {
      "types": "./dist/components/code-diff.d.ts",
      "default": "./dist/components/code-diff.js"
    },
    "./components/code-diff-source": {
      "types": "./dist/components/code-diff-source.d.ts",
      "default": "./dist/components/code-diff-source.js"
    },
    "./styles/code-diff.css": "./dist/styles/code-diff.css",
    "./protocol-exchange": {
      "types": "./dist/protocol-exchange/index.d.ts",
      "default": "./dist/protocol-exchange/index.js"
    },
    "./protocol-exchange/data": {
      "types": "./dist/protocol-exchange/data.d.ts",
      "default": "./dist/protocol-exchange/data.js"
    },
    "./components/protocol-exchange": {
      "types": "./dist/components/protocol-exchange.d.ts",
      "default": "./dist/components/protocol-exchange.js"
    },
    "./styles/protocol-exchange.css": "./dist/styles/protocol-exchange.css",
    "./span-waterfall": {
      "types": "./dist/span-waterfall/index.d.ts",
      "default": "./dist/span-waterfall/index.js"
    },
    "./span-waterfall/data": {
      "types": "./dist/span-waterfall/data.d.ts",
      "default": "./dist/span-waterfall/data.js"
    },
    "./components/span-waterfall": {
      "types": "./dist/components/span-waterfall.d.ts",
      "default": "./dist/components/span-waterfall.js"
    },
    "./styles/span-waterfall.css": "./dist/styles/span-waterfall.css",
    "./components/code-walkthrough": {
      "types": "./dist/components/code-walkthrough.d.ts",
      "default": "./dist/components/code-walkthrough.js"
    },
    "./components/code-walkthrough-source": {
      "types": "./dist/components/code-walkthrough-source.d.ts",
      "default": "./dist/components/code-walkthrough-source.js"
    },
    "./styles/code-walkthrough.css": "./dist/styles/code-walkthrough.css",
    "./code-walkthrough": {
      "types": "./dist/code-walkthrough/index.d.ts",
      "default": "./dist/code-walkthrough/index.js"
    },
    "./code-walkthrough/data": {
      "types": "./dist/code-walkthrough/data.d.ts",
      "default": "./dist/code-walkthrough/data.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:pack": "npm run build && node scripts/smoke-pack.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run test:pack",
    "test:browser": "npm run build && playwright test"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@d2lang/d2": "0.1.34",
    "@types/mdast": "^4.0.4",
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "^4.1.2",
    "remark-frontmatter": "^5.0.0",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.12.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "19.3.0",
    "esbuild": "^0.28.2",
    "mdast-util-mdx-jsx": "^3.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.3"
  }
}
