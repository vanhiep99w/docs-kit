# A categorical timeline, NOT a proportional time axis.
grid-columns: 2
grid-gap: 20

y1990: "Trước 2000" {shape: text}
monolith: "Monolithic architecture\nỨng dụng triển khai như một khối"
y2000: "2000s" {shape: text}
soa: "SOA phổ biến\nDịch vụ và tích hợp trong enterprise"
y2010: "2010s" {shape: text}
microservices: "Microservices nổi lên\nDịch vụ có thể triển khai độc lập"
y2015: "Giữa 2010s+" {shape: text}
cloud: "Cloud-native phát triển\nContainers và orchestration hỗ trợ"
